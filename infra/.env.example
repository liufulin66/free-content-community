# 复制成 .env 后修改所有 change-me 值
# 密码建议使用字母、数字、- 和 _，避免 $ # 等会被 Compose 解析的字符

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=free_content
MYSQL_USER=app
MYSQL_PASSWORD=change-me-app
MYSQL_PORT=3307

# Redis
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6380

# RabbitMQ
RABBITMQ_USER=app
RABBITMQ_PASSWORD=change-me-mq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=free-content
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# Elasticsearch（P1，profile=search）
ES_PORT=9200
