# 复制成 .env 后修改所有 change-me 值
# 密码建议使用字母、数字、- 和 _，避免 $ # 等会被 Compose 解析的字符

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=free_content
MYSQL_USER=app
MYSQL_PASSWORD=change-me-app
MYSQL_PORT=3307

# Redis
REDIS_PASSWORD=change-me-redis
REDIS_PORT=6380

# 邮箱验证码 HMAC / AES-GCM 密钥（32字节随机值的Base64）
# 以下仅为本地开发示例，生产必须用 `openssl rand -base64 32` 重新生成两个不同值
EMAIL_CHALLENGE_MAC_KEY_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
EMAIL_CHALLENGE_ENCRYPTION_KEY_BASE64=ZmVkY2JhOTg3NjU0MzIxMGZlZGNiYTk4NzY1NDMyMTA=

# 浏览器跨域来源（逗号分隔）；默认允许 Vite 与 nginx 本地入口
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://127.0.0.1:8088

# RabbitMQ
RABBITMQ_USER=app
RABBITMQ_PASSWORD=change-me-mq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=free-content
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_REGION=us-east-1

# 上传策略（后端 app.media.upload-policy，MIME列表用逗号分隔）
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=524288000
MEDIA_ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif
MEDIA_ALLOWED_VIDEO_MIME_TYPES=video/mp4
MEDIA_MULTIPART_THRESHOLD_BYTES=16777216
MEDIA_MAX_PART_COUNT=10000
MEDIA_UPLOAD_URL_TTL_SECONDS=600

# 上传会话创建（后端 app.media.upload-creation）
MEDIA_UPLOAD_SESSION_TTL_SECONDS=7200
MEDIA_UPLOAD_IP_PER_MINUTE_LIMIT=60
MEDIA_UPLOAD_USER_HOURLY_LIMIT=100
MEDIA_UPLOAD_REDIS_KEY_PREFIX=fc:media:

# 上传查询与续签（后端 app.media.upload-query，独立分钟窗口）
MEDIA_UPLOAD_QUERY_IP_PER_MINUTE_LIMIT=120
MEDIA_UPLOAD_QUERY_USER_PER_MINUTE_LIMIT=60
MEDIA_UPLOAD_QUERY_REDIS_KEY_PREFIX=fc:media:

# 取消上传（独立分钟窗口）
MEDIA_UPLOAD_CANCEL_IP_PER_MINUTE_LIMIT=120
MEDIA_UPLOAD_CANCEL_USER_PER_MINUTE_LIMIT=60
MEDIA_UPLOAD_CANCEL_REDIS_KEY_PREFIX=fc:media:

# 完成上传（独立分钟窗口，包含幂等重放）
MEDIA_UPLOAD_COMPLETION_IP_PER_MINUTE_LIMIT=120
MEDIA_UPLOAD_COMPLETION_USER_PER_MINUTE_LIMIT=60
MEDIA_UPLOAD_COMPLETION_REDIS_KEY_PREFIX=fc:media:
MEDIA_UPLOAD_COMPLETION_RETRY_AFTER_SECONDS=2

# 本人媒体任务查询（独立分钟窗口）
MEDIA_TASK_QUERY_IP_PER_MINUTE_LIMIT=120
MEDIA_TASK_QUERY_USER_PER_MINUTE_LIMIT=60
MEDIA_TASK_QUERY_REDIS_KEY_PREFIX=fc:media:

# 本人素材校验结果查询（独立分钟窗口）
MEDIA_ASSET_QUERY_IP_PER_MINUTE_LIMIT=120
MEDIA_ASSET_QUERY_USER_PER_MINUTE_LIMIT=60
MEDIA_ASSET_QUERY_REDIS_KEY_PREFIX=fc:media:

# 已取消上传的后台回收（原会话到期时间 + 缓冲后清理）
MEDIA_UPLOAD_CLEANUP_ENABLED=true
MEDIA_UPLOAD_CLEANUP_GRACE_SECONDS=600
MEDIA_UPLOAD_CLEANUP_POLL_DELAY_MILLIS=1000
MEDIA_UPLOAD_CLEANUP_LEASE_SECONDS=60
MEDIA_UPLOAD_CLEANUP_MAX_ATTEMPTS=3
MEDIA_UPLOAD_CLEANUP_RETRY_BASE_SECONDS=5

# 可信反向代理网段（可选；默认信任本机与私网。生产按实际代理网段覆盖正则）
# TRUSTED_PROXY_PATTERN=10\.0\.0\.\d{1,3}|192\.168\.\d{1,3}\.\d{1,3}

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
MAIL_SMTP_CONNECTION_TIMEOUT_MILLIS=3000
MAIL_SMTP_READ_TIMEOUT_MILLIS=5000
MAIL_SMTP_WRITE_TIMEOUT_MILLIS=5000

# Elasticsearch（P1，profile=search）
ES_PORT=9200
