        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "kind": {
        "type": "string",
        "description": "内容类型；创建后不能修改。",
        "enum": [
          "ARTICLE",
          "VIDEO"
        ]
      },
      "title": {
        "type": "string",
        "description": "已审核发布的标题",
        "minLength": 1,
        "maxLength": 120
      },
      "summary": {
        "type": "string",
        "description": "服务端生成的摘要",
        "maxLength": 300
      },
      "author": {
        "$ref": "#/components/schemas/PublicUser"
      },
      "coverAssetId": {
        "anyOf": [
          {
            "type": "string",
            "description": "封面素材ID",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          {
            "type": "null"
          }
        ]
      },
      "tags": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Tag"
        },
        "description": "标签",
        "maxItems": 5
      },
      "firstPublishedAt": {
        "type": "string",
        "description": "首次发布时间；后续版本发布不改变此排序字段",
        "format": "date-time",
        "examples": [
          "2026-11-03T08:00:00Z"
        ]
      },
      "publishedAt": {
        "type": "string",
        "description": "当前公开版本发布时间",
        "format": "date-time",
        "examples": [
          "2026-11-03T08:00:00Z"
        ]
      },
      "publishedRevisionId": {
        "type": "string",
        "description": "当前公开版本ID",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "likeCount": {
        "type": "integer",
        "description": "点赞展示计数，允许短暂延迟",
        "minimum": 0
      },
      "commentCount": {
        "type": "integer",
        "description": "可见评论展示计数",
        "minimum": 0
      },
      "viewerHasLiked": {
        "type": "boolean",
        "description": "当前登录用户是否已点赞；游客为false"
      },
      "viewerHasBookmarked": {
        "type": "boolean",
        "description": "当前登录用户是否已收藏；游客为false"
      }
    },
    "required": [
      "id",
      "kind",
      "title",
      "summary",
      "author",
      "coverAssetId",
      "tags",
      "firstPublishedAt",
      "publishedAt",
      "publishedRevisionId",
      "likeCount",
      "commentCount",
      "viewerHasLiked",
      "viewerHasBookmarked"
    ],
    "additionalProperties": true
  }
}
