{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "infra: up",
      "detail": "启动 Docker 中间件（必要时自动拉起 Docker Desktop）",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "dev-up.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}/infra"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "backend: run",
      "detail": "加载 infra/.env 后启动 Spring Boot",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "run-local.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "启动项目（中间件 + 后端）",
      "detail": "先启动中间件，脚本结束后再启动后端",
      "dependsOn": [
        "infra: up",
        "backend: run"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
